# Endereço HTTP do servidor
HTTP_HOST=127.0.0.1
HTTP_PORT=3001

# Banco SQLite. O arquivo é criado no primeiro boot/import.
DATABASE_URL=sqlite://data/timeline.db

# Export do Google Maps Timeline usado pelo binário de import.
TIMELINE_JSON_PATH=../timeline.json

# Rodar migrations no boot (default: true). Use 0/false para desligar.
RUN_MIGRATIONS=true

# Identificação exigida pela política de uso do Nominatim (OpenStreetMap).
NOMINATIM_USER_AGENT=timeline-api/0.1 (contato@exemplo.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
